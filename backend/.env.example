ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@DB_HOST:5432/DB_NAME
DB_ECHO=false
AUTO_CREATE_SCHEMA=false
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_V1_STR=/api/v1
API_URL=https://pos.example.com/api/v1
LOG_LEVEL=warning
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD
BACKEND_CORS_ORIGINS=["https://pos.example.com"]